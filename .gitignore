# Public study materials and the explicitly listed model exports belong in Git.
# Human archives, ID maps and all other data folders stay local.
/data/*
!/data/study_manifest.json
!/data/stimuli/
# PRIVATE GENERATED DATA: may contain participant-level human records. Keep local or delete;
# these do not need a second private-cloud archive because they are reproducible.
/intermediate/
# RELEASE CANDIDATES: generated figures, tables and exported summaries.
# Keep untracked until reviewed for public release.
/results/
# Protect recognizable raw exports even when saved outside their usual folders.
participants.jsonl*
responses.jsonl*
assignments.jsonl
quality_checks.jsonl
payment_ledger.jsonl
events.jsonl
audit_events.jsonl
id_map.csv*
*_retained.jsonl
raw.jsonl
scored.jsonl
final_summary.jsonl
# Only the five reviewed, compressed model exports and their manifest are public.
# New collection runs and original provider manifests remain ignored.
!/data/ai/
/data/ai/**
!/data/ai/manifest.json
!/data/ai/openai/
!/data/ai/openai/main/
!/data/ai/openai/module/
!/data/ai/anthropic/
!/data/ai/anthropic/main/
!/data/ai/anthropic/module/
!/data/ai/gemini/
!/data/ai/gemini/formal/
!/data/ai/openai/main/responses.jsonl.gz
!/data/ai/openai/module/responses.jsonl.gz
!/data/ai/anthropic/main/responses.jsonl.gz
!/data/ai/anthropic/module/responses.jsonl.gz
!/data/ai/gemini/formal/responses.jsonl.gz
# Local execution files and credentials.
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.mplconfig/
.cache/
.DS_Store
.env
.env.*
credentials*.json
